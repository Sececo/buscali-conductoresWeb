# Origen del backend (sin barra final). Debe coincidir con host:PORT del backend (por defecto 3000).
# Para API en la nube: URL del backend desplegado (ej. https://tu-api.onrender.com).
VITE_API_URL=http://localhost:3000
# true = peticiones relativas /api… (proxy Vite en dev y preview; recomendado en local).
VITE_USE_PROXY=true
